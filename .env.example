# Copy this file to .env and fill in your own values.
# NEVER commit .env or paste real connection strings anywhere else.

# Local PostgreSQL 16 (no SSL required)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Neon free-tier PostgreSQL (requires SSL)
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx-123456.region.aws.neon.tech/DATABASE_NAME?sslmode=require
